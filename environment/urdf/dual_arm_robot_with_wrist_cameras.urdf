  <transmission name="rgripper_finger_joint_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rgripper_finger_joint">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="rgripper_finger_joint_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <!-- Attach RIGHT gripper to right_tool0 -->
  <joint name="rgripper_mount" type="fixed">
    <parent link="right_tool0"/>
    <child link="rgripper_robotiq_arg2f_base_link"/>
    <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ===================== -->
  <!-- Gazebo + ros2_control -->
  <!-- ===================== -->
  <gazebo reference="world">
  </gazebo>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/hamidreza/Downloads/dual_arm_ws_gz/install/ur_simulation_gz/share/ur_simulation_gz/config/dual_ur5e_controllers_gz.yaml</parameters>
      <ros>
        <namespace></namespace>
      </ros>
    </plugin>
  </gazebo>
  <!-- Add URDF transmission elements (for ros_control) -->
  <!--<xacro:ur_arm_transmission prefix="${prefix}" hw_interface="${transmission_hw_interface}" />-->
  <!-- Placeholder for ros2_control transmission which don't yet exist -->
  <ros2_control name="left_arm" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_shoulder_pan_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="left_shoulder_lift_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="left_elbow_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="left_wrist_1_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="left_wrist_2_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="left_wrist_3_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </ros2_control>
  <!-- Add URDF transmission elements (for ros_control) -->
  <!--<xacro:ur_arm_transmission prefix="${prefix}" hw_interface="${transmission_hw_interface}" />-->
  <!-- Placeholder for ros2_control transmission which don't yet exist -->
  <ros2_control name="right_arm" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="right_shoulder_pan_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="right_shoulder_lift_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="right_elbow_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="right_wrist_1_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="right_wrist_2_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="right_wrist_3_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </ros2_control>
  <!-- LEFT Robotiq 2F-140 main actuated joint -->
  <!-- <joint name="$(arg robot_body_prefix)lgripper_finger_joint" type="fixed">
      <command_interface name="position"/>
      <state_interface   name="position"/>
      <state_interface   name="velocity"/>
    </joint> -->
  <!-- RIGHT Robotiq 2F-140 main actuated joint -->
  <!-- <joint name="$(arg robot_body_prefix)rgripper_finger_joint" type="fixed">
      <command_interface name="position"/>
      <state_interface   name="position"/>
      <state_interface   name="velocity"/>
    </joint> -->
  <!-- Left gripper -->
  <ros2_control name="left_gripper" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="lgripper_finger_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <!-- Rightt gripper -->
  <ros2_control name="right_gripper" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="rgripper_finger_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <!-- ===================== -->
  <!--   Add Robot Sensors   -->
  <!-- ===================== -->
  <!-- ========================================================= -->
  <!-- HEAD-MOUNTED KINECT CAMERA                                -->
  <!-- Fully working version for ros_gz_sim (Ignition Gazebo)    -->
  <!-- ========================================================= -->
  <!-- ========================================================= -->
  <!-- Base Kinect link                                           -->
  <!-- ========================================================= -->
  <link name="head_mount_kinect_link">
    <!-- <visual>
      <geometry>
        <box size="0.04 0.15 0.04"/>
      </geometry>
      <material name="kinect_gray">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual> -->
    <!-- <collision>
      <geometry>
        <box size="0.04 0.15 0.04"/>
      </geometry>
    </collision> -->
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <!-- Mount camera to robot head -->
  <joint name="head_mount_kinect_joint" type="fixed">
    <parent link="robot_head_link"/>
    <child link="head_mount_kinect_link"/>
    <origin rpy="0 0 0" xyz="0.076 0.018 0.110"/>
  </joint>
  <!-- ========================================================= -->
  <!-- Depth Camera Frames                                        -->
  <!-- ========================================================= -->
  <joint name="head_mount_kinect_depth_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.018 0"/>
    <parent link="head_mount_kinect_link"/>
    <child link="head_mount_kinect_depth_frame"/>
  </joint>
  <link name="head_mount_kinect_depth_frame">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="head_mount_kinect_depth_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="head_mount_kinect_depth_frame"/>
    <child link="head_mount_kinect_depth_optical_frame"/>
  </joint>
  <link name="head_mount_kinect_depth_optical_frame">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <!-- ========================================================= -->
  <!-- RGB Camera Frames                                          -->
  <!-- ========================================================= -->
  <joint name="head_mount_kinect_rgb_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.005 0"/>
    <parent link="head_mount_kinect_link"/>
    <child link="head_mount_kinect_rgb_frame"/>
  </joint>
  <link name="head_mount_kinect_rgb_frame">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="head_mount_kinect_rgb_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="head_mount_kinect_rgb_frame"/>
    <child link="head_mount_kinect_rgb_optical_frame"/>
  </joint>
  <link name="head_mount_kinect_rgb_optical_frame">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <!-- ========================================================= -->
  <!-- Gazebo RGB-D Camera Sensor (Gazebo Sim 8.10.0)            -->
  <!-- ========================================================= -->
  <gazebo reference="head_mount_kinect_link">
    <sensor name="kinect_rgbd" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
        <!-- RGB optical frame for RGB topic -->
        <!-- In the previous version (ROS1) we used  head_mount_kinect_rgb_optical_frame -->
        <optical_frame_id>
          head_mount_kinect_rgb_frame
        </optical_frame_id>
      </camera>
      <depth_camera>
        <output>depth</output>
      </depth_camera>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <topic>/head_mount_kinect</topic>
      <!-- Gazebo Sim core sensor system -->
      <!-- <plugin name="gz::sim::systems::Sensors" filename="libgz-sim-sensors-system.so"/> -->
    </sensor>
  </gazebo>
  <!-- Base link of camera -->
  <link name="left_arm_camera_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
    <!-- ========================================================= -->
    <!-- Visual model of D435 (or other camera)                    -->
    <!-- ========================================================= -->
    <!-- Camera body mesh -->
    <visual name="left_arm_camera_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/d435.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <!-- Small cylinder base for eye-in-hand camera -->
    <visual name="left_arm_camera_stand_visual">
      <origin rpy="0 0 0" xyz="-0.015 0 -0.05"/>
      <!-- Adjust up/down as needed -->
      <geometry>
        <cylinder length="0.1" radius="0.01"/>
      </geometry>
      <material name="Gray">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="left_arm_camera_joint" type="fixed">
    <!-- keep your pose here, only syntax fixed -->
    <!-- <origin xyz="0 -0.10 0" rpy="${M_PI/2} ${-M_PI/2} 0"/> -->
    <origin rpy="1.5707963267948966 -1.5707963267948966 0" xyz="0 -0.10 0"/>
    <parent link="left_tool0"/>
    <child link="left_arm_camera_link"/>
  </joint>
  <!-- RGB frame -->
  <link name="left_arm_camera_rgb_frame">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="left_arm_camera_rgb_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.005 0"/>
    <parent link="left_arm_camera_link"/>
    <child link="left_arm_camera_rgb_frame"/>
  </joint>
  <!-- Optical frame -->
  <link name="left_arm_camera_rgb_optical_frame">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="left_arm_camera_rgb_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="left_arm_camera_rgb_frame"/>
    <child link="left_arm_camera_rgb_optical_frame"/>
  </joint>
  <!-- ========================================================= -->
  <!-- Gazebo RGBD camera                                        -->
  <!-- ========================================================= -->
  <gazebo reference="left_arm_camera_link">
    <sensor name="left_arm_camera_rgbd" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>5.0</far>
        </clip>
        <!-- Optical frame ID -->
        <optical_frame_id>left_arm_camera_rgb_frame</optical_frame_id>
      </camera>
      <depth_camera>
        <output>depth</output>
      </depth_camera>
      <visualize>true</visualize>
      <topic>left_arm</topic>
    </sensor>
  </gazebo>
  <!-- Base link of camera -->
  <link name="right_arm_camera_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
    <!-- ========================================================= -->
    <!-- Visual model of D435 (or other camera)                    -->
    <!-- ========================================================= -->
    <!-- Camera body mesh -->
    <visual name="right_arm_camera_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/d435.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <!-- Small cylinder base for eye-in-hand camera -->
    <visual name="right_arm_camera_stand_visual">
      <origin rpy="0 0 0" xyz="-0.015 0 -0.05"/>
      <!-- Adjust up/down as needed -->
      <geometry>
        <cylinder length="0.1" radius="0.01"/>
      </geometry>
      <material name="Gray">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="right_arm_camera_joint" type="fixed">
    <!-- keep your pose here, only syntax fixed -->
    <!-- <origin xyz="0 -0.10 0" rpy="${M_PI/2} ${-M_PI/2} 0"/> -->
    <origin rpy="1.5707963267948966 -1.5707963267948966 0" xyz="0 -0.10 0"/>
    <parent link="right_tool0"/>
    <child link="right_arm_camera_link"/>
  </joint>
  <!-- RGB frame -->
  <link name="right_arm_camera_rgb_frame">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="right_arm_camera_rgb_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.005 0"/>
    <parent link="right_arm_camera_link"/>
    <child link="right_arm_camera_rgb_frame"/>
  </joint>
  <!-- Optical frame -->
  <link name="right_arm_camera_rgb_optical_frame">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="right_arm_camera_rgb_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="right_arm_camera_rgb_frame"/>
    <child link="right_arm_camera_rgb_optical_frame"/>
  </joint>
 
</robot>
